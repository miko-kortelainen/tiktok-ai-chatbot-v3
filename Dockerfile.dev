# Development Dockerfile with hot reloading

# Frontend
FROM node:24 AS frontend

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY shared/package.json ./shared/

RUN pnpm install --frozen-lockfile

COPY client ./client
COPY shared ./shared

EXPOSE 8081

CMD ["pnpm", "--filter", "tiktok-ai-chatbot-frontend", "dev", "--", "--host"]

# Backend
FROM node:24 AS backend

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY shared/package.json ./shared/

RUN pnpm install --frozen-lockfile

COPY server ./server
COPY shared ./shared

EXPOSE 8080

CMD ["pnpm", "--filter", "tiktok-ai-chatbot-backend", "dev:watch"]
